/*
 * rnd-longmer-library-qc-nf
 * Nanopore QC for direct-print long-oligo (750mer) paired VH+VL libraries.
 */

manifest {
    name            = 'rnd-longmer-library-qc-nf'
    author          = 'Twist Bioscience R&D'
    description     = 'Nanopore QC for direct-print long-oligo VH+VL libraries: VH/VL pairing chimera by content deconvolution, internal block deletions, uniformity, dropout and screening depth, with per-run classifier and deletion-caller calibration.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // ---- inputs (per run) ----
    reference          = null    // design reference CSV (gene,order,well,vh_len_nt,construct_dna,...)
    input              = null    // samplesheet CSV: sublibrary,fastq_dir
    // Launchpad single-folder alternative to --input (one sub-library per run).
    fastq_path         = null
    sublibrary         = null
    outdir             = null

    // ---- construct architecture (change only for a different build) ----
    flank5             = 'CAATCCGCCCTCACTACAACCGGGTCTCAAAGC'
    flank3             = 'TTCGAGAGACCCTACTCTGGCGTCGATGAGGGA'
    intermediate_len   = 162

    // ---- classifier ----
    // A half is assigned only if best - runner-up >= margin matching bases over an
    // alignment of >= min_mlen. Loosening either without re-running the controls
    // invalidates the quoted chimera rate.
    margin             = 15
    min_mlen           = 120

    // ---- block-deletion caller ----
    blockdel_subsample = 8       // every Nth read; the rate converges far below full depth
    min_del            = 20      // record gaps from here
    call_del           = 50      // report gaps from here (controls: 100% sensitivity, 0 false calls)
    max_events         = 300000

    // ---- controls (per-condition sample sizes) ----
    n_control_negative = 50000
    n_control_positive = 500
    n_control_deletion = 600

    // ---- stages ----
    skip_blockdel      = false
    skip_controls      = false
    strict_reference   = false
    max_reads_per_shard = 0      // testing only; 0 = all reads

    // ---- optional extra inputs ----
    compare            = null    // prior-build metrics JSON for the head-to-head figure
    microhomology      = null    // per-well microhomology CSV (design-side)
    design_screen      = null    // design_primer_screen.json
    logo               = null    // letterhead image for the customer collateral

    // ---- output naming / collateral header ----
    library_name       = 'library'
    product            = 'Direct-Print scFv Library (Ultra Long MGF)'
    account            = ''
    order_number       = ''
    order_items        = ''
    manufacture_date   = ''

    fastq_pattern      = '*.fastq.gz'
    publish_dir_mode   = 'copy'
    help               = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Wave builds each module's `conda "${moduleDir}/environment.yml"` into a container image
// and caches it in ECR. Do NOT set `conda.enabled = true` globally: that builds a native
// conda env in the work dir, which fails on a non-POSIX S3 work dir. Wave reads the conda
// directives itself; conda.enabled is only turned on in the local `stub` profile.
wave {
    enabled          = true
    freeze           = true
    strategy         = 'conda,container'
    build.repository = '749602843853.dkr.ecr.us-west-2.amazonaws.com/seqera/wave-cache'
}

// Grant the S3 bucket owner full control of objects written from the compute env.
aws {
    client {
        s3Acl = 'BucketOwnerFullControl'
    }
}

profiles {
    // `standard` is the default. Do NOT force process.executor = 'local' here — on Seqera
    // that pins every task to the head node instead of submitting to the compute env.
    standard {
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        includeConfig 'conf/test.config'
    }
    local {
        // Local end-to-end run against the bundled test data, using whatever tools are on
        // PATH. No Wave, no conda build, no S3.
        conda.enabled    = false
        wave.enabled     = false
        process.executor = 'local'
        includeConfig 'conf/test.config'
    }
    stub {
        // Wiring proof only: `nextflow run . -profile stub -stub`. No Wave (which needs
        // Seqera credentials), no conda, no tools, no data.
        conda.enabled    = false
        wave.enabled     = false
        process.executor = 'local'
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
