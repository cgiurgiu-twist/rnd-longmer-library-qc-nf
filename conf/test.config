/*
 * Test profile — a small bundled slice of a real run.
 *
 *   nextflow run . -profile local      (end-to-end, tools from PATH)
 *   nextflow run . -profile test -stub (wiring only, no tools)
 *
 * The fixtures are the first 2,500 reads of two FASTQ files per sub-library from
 * Q-724749, against a 600-construct slice of that library's reference. Rates from this
 * slice are NOT the library's rates — it exists to prove the pipeline runs end to end.
 */

params {
    reference          = "${projectDir}/tests/fixtures/reference_slice.csv"
    input              = "${projectDir}/tests/fixtures/samplesheet.csv"
    outdir             = 'results_test'
    library_name       = 'testslice'
    blockdel_subsample = 1
    n_control_negative = 300
    n_control_positive = 100
    n_control_deletion = 60
}

// The bundled fixtures are tiny; the production resource labels would refuse to schedule
// on a laptop or a CI box, so the test profile asks for what the fixtures actually need.
process {
    cpus = 1
    memory = 2.GB
    withLabel: process_low    { cpus = 1; memory = 2.GB }
    withLabel: process_medium { cpus = 1; memory = 3.GB }
    withLabel: process_high   { cpus = 1; memory = 3.GB }
    withLabel: process_merge   { cpus = 1; memory = 3.GB }
}
