/*
 * Default process resources.
 *
 * Each process declares its own tools via `conda "${moduleDir}/environment.yml"`; Wave
 * builds and caches the per-module image at runtime. There is no single baked image.
 *
 * Sizing note: CLASSIFY_READS and BLOCKDEL_READS are one task per FASTQ file and hold the
 * half-reference index in memory (~1 GB for 136k halves). BLOCKDEL_READS additionally
 * builds a small splice index per construct, capped at 512 cached — do not raise that cap
 * to "speed it up"; a large cache of live minimap2 indexes is what exhausts the node.
 */

process {
    cpus   = { 1     * task.attempt }
    memory = { 6.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // The merge holds every per-shard JSON plus the per-gene table; it is memory-bound,
    // not cpu-bound, and grows with library size rather than with read count.
    // This is a label, not a withName selector: a withName block in a later-included
    // config replaces the earlier one wholesale, which silently drops its publishDir.
    withLabel: process_merge {
        cpus   = { 2     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
