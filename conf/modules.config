process {
    withName: 'BUILD_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,gz}"
        ]
    }
    withName: 'RUN_CONTROLS' {
        publishDir = [
            path: { "${params.outdir}/metrics" },
            mode: params.publish_dir_mode
        ]
    }
    // The merge emits `metrics/*`; publish each file by basename into metrics/ so the
    // bundle sits beside the controls and derived stats it is read with.
    withName: 'MERGE_METRICS' {
        publishDir = [
            path: { "${params.outdir}/metrics" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'ANALYZE' {
        publishDir = [
            path: { "${params.outdir}/metrics" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MAKE_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/plots" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.substring(fn.lastIndexOf("/") + 1) }
        ]
    }
    withName: 'MAKE_OUTPUTS' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode
        ]
    }
}
